; Engine configuration file.
; Written by /setup-engine for Godot 4.7 (mobile, 2D, Compatibility renderer).
; NOT VERIFIED — no Godot binary could be run in the dev container. Open the
; project once in the Godot 4.7 editor to import it and generate .godot/.

config_version=5

[application]

config/name="Errante de Vesper"
config/description="Run-and-gun boss rush 2D para celular (estrutura inspirada no genero, conteudo original)."
run/main_scene="res://src/ui/title/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

EventBus="*res://src/autoload/event_bus.gd"
GameSettings="*res://src/autoload/game_settings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player_body"
2d_physics/layer_3="player_hurtbox"
2d_physics/layer_4="enemy_hurtbox"
2d_physics/layer_5="player_attack"
2d_physics/layer_6="enemy_attack"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.06, 0.09, 1)
